{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RAYWAVES_TOOLCHAIN": "auto"
      }
    },
    {
      "name": "zig-debug",
      "displayName": "Debug",
      "description": "Debug build (Zig on Windows, system GCC/G++ on Linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "zig-release",
      "displayName": "Release",
      "description": "Release build (Zig on Windows, system GCC/G++ on Linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "zig-debug",
      "configurePreset": "zig-debug"
    },
    {
      "name": "zig-release",
      "configurePreset": "zig-release"
    }
  ],
  "testPresets": [
    {
      "name": "zig-debug",
      "displayName": "Debug Tests",
      "configurePreset": "zig-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "zig-release",
      "displayName": "Release Tests",
      "configurePreset": "zig-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure, build and test (Debug)",
      "steps": [
        { "type": "configure", "name": "zig-debug" },
        { "type": "build", "name": "zig-debug" },
        { "type": "test", "name": "zig-debug" }
      ]
    },
    {
      "name": "ci",
      "displayName": "Configure, build and test (Release)",
      "steps": [
        { "type": "configure", "name": "zig-release" },
        { "type": "build", "name": "zig-release" },
        { "type": "test", "name": "zig-release" }
      ]
    }
  ]
}
