cmake_minimum_required(VERSION 3.25)

# ---------------------------------------------------------------------------
# Platform setup. This file is generated by the editor; edit the template in
# packaging/Project.CMakeLists.in, not this copy.
# ---------------------------------------------------------------------------

if(WIN32)
    set(RAYWAVES_C_COMPILER "@TOOLS_DIR@/zig-cc.bat")
    set(RAYWAVES_CXX_COMPILER "@TOOLS_DIR@/zig-cxx.bat")
    set(RAYWAVES_NINJA "@TOOLS_DIR@/ninja/ninja.exe")
    set(RAYWAVES_SETUP "@TOOLS_DIR@/setup_tools.ps1")
    set(RAYWAVES_PLATFORM_LIBS dwmapi)
else()
    set(RAYWAVES_C_COMPILER "@C_COMPILER@")
    set(RAYWAVES_CXX_COMPILER "@CXX_COMPILER@")
    set(RAYWAVES_NINJA "@TOOLS_DIR@/ninja/ninja")
    set(RAYWAVES_SETUP "@TOOLS_DIR@/setup_tools.sh")
    set(RAYWAVES_PLATFORM_LIBS "")
endif()

if(WIN32 AND NOT EXISTS "@TOOLS_DIR@/zig/zig.exe" AND NOT EXISTS "@TOOLS_DIR@/zig/zig")
    message(STATUS "Zig toolchain not found. Auto-fetching...")
    execute_process(
        COMMAND powershell -ExecutionPolicy Bypass -File "${RAYWAVES_SETUP}" -SkipRcEdit -SkipNinja
        WORKING_DIRECTORY "@ENGINE_ROOT@"
        RESULT_VARIABLE ZIG_FETCH_RESULT
    )
    if(NOT ZIG_FETCH_RESULT EQUAL 0)
        message(FATAL_ERROR "Failed to download Zig.")
    endif()
endif()

if(NOT EXISTS "${RAYWAVES_NINJA}")
    message(STATUS "Ninja not found. Auto-fetching...")
    if(WIN32)
        execute_process(
            COMMAND powershell -ExecutionPolicy Bypass -File "${RAYWAVES_SETUP}" -SkipZig -SkipRcEdit -SkipCMake
            WORKING_DIRECTORY "@ENGINE_ROOT@"
            RESULT_VARIABLE NINJA_FETCH_RESULT
        )
    else()
        execute_process(
            COMMAND bash "${RAYWAVES_SETUP}" --skip-zig --skip-rcedit --skip-cmake
            WORKING_DIRECTORY "@ENGINE_ROOT@"
            RESULT_VARIABLE NINJA_FETCH_RESULT
        )
    endif()
    if(NOT NINJA_FETCH_RESULT EQUAL 0)
        message(FATAL_ERROR "Failed to download Ninja.")
    endif()
endif()

if(NOT EXISTS "${RAYWAVES_NINJA}")
    find_program(RAYWAVES_SYSTEM_NINJA ninja)
    if(RAYWAVES_SYSTEM_NINJA)
        set(RAYWAVES_NINJA "${RAYWAVES_SYSTEM_NINJA}")
    endif()
endif()

set(CMAKE_MAKE_PROGRAM "${RAYWAVES_NINJA}" CACHE FILEPATH "Build program" FORCE)
set(CMAKE_C_COMPILER "${RAYWAVES_C_COMPILER}")
set(CMAKE_CXX_COMPILER "${RAYWAVES_CXX_COMPILER}")

project(@PROJECT_NAME@)

find_package(Threads REQUIRED)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(X11 REQUIRED)
    set(RAYWAVES_PLATFORM_LIBS X11::X11)
endif()

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(UNIX)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(CMAKE_BUILD_RPATH_USE_ORIGIN ON)
    # Avoid STB_GNU_UNIQUE symbols: glibc marks such DSOs NODELETE, which
    # prevents safe hot-reload dlclose().
    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fno-gnu-unique>)
endif()

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|i.86)$")
    add_compile_options(-msse4.2)
endif()

set(ENGINE_DIR "@ENGINE_DIR@")
set(RAYLIB_DIR "@RAYLIB_DIR@")
set(PROJECT_SRC_DIR "${CMAKE_SOURCE_DIR}/../GameLogic")

add_library(GameLogic SHARED)
set_target_properties(GameLogic PROPERTIES PREFIX "")

file(GLOB_RECURSE SRC_FILES CONFIGURE_DEPENDS "${PROJECT_SRC_DIR}/*.cpp")
# Non-recursive: Engine/Platform/* implementation files are host-specific and
# must not be pulled into both platform builds.
file(GLOB ENGINE_SRC CONFIGURE_DEPENDS "${ENGINE_DIR}/Engine/*.cpp")
target_sources(GameLogic PRIVATE ${SRC_FILES} ${ENGINE_SRC})

target_include_directories(GameLogic PRIVATE
    "${ENGINE_DIR}"
    "${ENGINE_DIR}/Engine"
    "${ENGINE_DIR}/Runtime"
    "${RAYLIB_DIR}/include"
)

# Resolve the raylib library by path instead of relying on -l name matching.
set(RAYLIB_IMPORT_LIB "")
foreach(CANDIDATE
    "${RAYLIB_DIR}/lib/libraylib.a"
    "${RAYLIB_DIR}/lib/libraylib.dll.a"
    "${RAYLIB_DIR}/lib/libraylib.so"
    "${RAYLIB_DIR}/lib/raylib.lib"
    "${RAYLIB_DIR}/libraylib.dll.a"
    "${RAYLIB_DIR}/libraylib.a"
    "${RAYLIB_DIR}/libraylib.so"
    "${RAYLIB_DIR}/raylib.lib")
    if(EXISTS "${CANDIDATE}")
        set(RAYLIB_IMPORT_LIB "${CANDIDATE}")
        break()
    endif()
endforeach()
if(NOT RAYLIB_IMPORT_LIB)
    message(FATAL_ERROR "raylib library not found under ${RAYLIB_DIR}. Rebuild the RayWaves editor so it stages raylib, then reopen the project.")
endif()

target_link_libraries(GameLogic PRIVATE "${RAYLIB_IMPORT_LIB}" ${RAYWAVES_PLATFORM_LIBS} Threads::Threads)

if(UNIX)
    set_target_properties(GameLogic PROPERTIES
        BUILD_RPATH "$ORIGIN"
        INSTALL_RPATH "$ORIGIN"
    )
endif()

set_target_properties(GameLogic PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/..")
set_target_properties(GameLogic PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/..")
