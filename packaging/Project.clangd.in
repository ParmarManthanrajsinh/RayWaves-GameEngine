# clangd reads this file before the compilation database. The explicit Zig
# libc++ paths let the template parse in editors even before a build exists.
# Generated by ProjectManager; rwcli lsp --force refreshes absolute paths.
CompileFlags:
  Add:
    - -fdeclspec
    - -std=c++23
@ZIG_TARGET_FLAGS@
@ZIG_ISYSTEMS@
    - -DPLATFORM_DESKTOP
    - -DGRAPHICS_API_OPENGL_33
@PROJECT_INCLUDES@
  Remove:
    - -Qunused-arguments
    - -msse4.2
    - -fno-gnu-unique
